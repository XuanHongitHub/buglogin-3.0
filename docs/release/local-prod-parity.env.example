# BugLogin local production-parity API environment.
# Copy to the repository root as .env.local, then replace the PostgreSQL
# credentials and certificate path for this machine.
#
# This runs the real BugLogin API and sync protocol with PostgreSQL metadata.
# Local API mode automatically uses the durable filesystem chunk store at:
#   %LOCALAPPDATA%\BugLogin\API\chunks\objects
# Do not set BUGLOGIN_S3_* here: that would switch blob storage to S3.
# The dev launcher sets BUGLOGIN_ENV=local and the desktop dev app targets this
# loopback API. A packaged desktop release always targets the hosted API.

BUGLOGIN_POSTGRES_URL=postgresql://buglogin_dev:REPLACE_WITH_LOCAL_PASSWORD@127.0.0.1:5432/buglogin_dev?sslmode=require
BUGLOGIN_POSTGRES_TLS_ROOT_CERT=C:\ProgramData\BugLogin\pg-tls\root-ca.crt
BUGLOGIN_API_BIND=127.0.0.1:12345
BUGLOGIN_MCP_ENABLED=true

# Compact public JSON values are sourced from the checked-in runtime catalog
# and trust map. These also feed the desktop dev build's public-key pin.

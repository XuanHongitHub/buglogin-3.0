# BugLogin 3.0 macOS desktop source build against the hosted API.
# Copy this file to the repository root as .env when building locally.
# Packaged releases already use these production defaults and need no env file.
# Build from the repository root with:
#   node scripts/run-with-env.mjs pnpm --dir apps/desktop tauri:build
# The tauri:dev script explicitly connects to a local API, regardless of this file.
BUGLOGIN_DEPLOYMENT_MODE=production
BUGLOGIN_API_BASE_URL=https://api3.buglogin.com

# For a locally signed/notarized macOS build, set these in the shell or in
# the private root .env. GitHub Actions obtains them from repository secrets.
# APPLE_SIGNING_IDENTITY=Developer ID Application: Name (TEAMID)
# APPLE_ID=
# APPLE_PASSWORD=
# APPLE_TEAM_ID=

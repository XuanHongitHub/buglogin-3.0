{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BugLogin",
  "version": "3.0.22",
  "identifier": "com.buglogin.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "BugLogin",
        "width": 1440,
        "height": 900
      }
    ],
    "security": { "csp": null }
  },
  "plugins": {
    "updater": {},
    "deep-link": {
      "desktop": {
        "schemes": ["buglogin", "https"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": [],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ]
  }
}


# macOS code signing + notarization for `pnpm tauri build`.
# Loaded into the build environment via scripts/run-with-env.mjs (and direnv via .envrc).
# APPLE_SIGNING_IDENTITY: the exact name of your Developer ID Application
#   certificate as it appears in `security find-identity -v -p codesigning`.
#   Example: "Developer ID Application: Your Name (TEAMID)"
# APPLE_ID + APPLE_PASSWORD + APPLE_TEAM_ID: credentials for notarytool.
#   APPLE_PASSWORD must be an app-specific password from appleid.apple.com,
#   not your real Apple ID password.
APPLE_TEAM_ID=
APPLE_ID=
APPLE_PASSWORD=
APPLE_SIGNING_IDENTITY=

# Optional web host. Browser auth uses same-origin cookies; never expose access
# tokens through NEXT_PUBLIC_* variables.
NEXT_PUBLIC_BUGLOGIN_API_BASE_URL=
NEXT_PUBLIC_BUGLOGIN_WORKSPACE_SCOPES=[]
# Opt-in trusted-TLS production adapter tests. Keep unset for normal local tests.
# Set BUGLOGIN_LIVE_ADAPTER_STRICT=1 in release CI so missing endpoints fail closed.
BUGLOGIN_LIVE_ADAPTER_STRICT=0
BUGLOGIN_POSTGRES_TEST_URL=
BUGLOGIN_S3_TEST_ENDPOINT=
BUGLOGIN_S3_TEST_BUCKET=
BUGLOGIN_S3_TEST_REGION=us-east-1
BUGLOGIN_S3_TEST_PREFIX=buglogin-live-tests
BUGLOGIN_S3_TEST_ACCESS_KEY=
BUGLOGIN_S3_TEST_SECRET_KEY=
BUGLOGIN_S3_TEST_SESSION_TOKEN=
BUGLOGIN_S3_TEST_PATH_STYLE=false

# Desktop authority mode. Required; never defaults.
# local: standalone/self-hosted local repository.
# production: hosted control/sync API only; BUGLOGIN_DATA_ROOT is forbidden.
BUGLOGIN_DEPLOYMENT_MODE=
BUGLOGIN_API_BASE_URL=
BUGLOGIN_DEVICE_VERIFICATION_URI=
BUGLOGIN_WEB_ORIGIN=
# Production recovery delivery. Both required; webhook URL must be HTTPS.
# Secret stays in Rust and is sent only as the webhook Authorization bearer value.
BUGLOGIN_RECOVERY_WEBHOOK_URL=
BUGLOGIN_RECOVERY_WEBHOOK_SECRET=
# Production bearer token; Rust process only. Never expose through NEXT_PUBLIC_*.
BUGLOGIN_API_TOKEN=
# Stable production device identity used by hosted lease/runtime projection.
BUGLOGIN_DEVICE_ID=
# Production-only local browser payload cache; never metadata/control authority.
BUGLOGIN_PROFILE_CACHE_ROOT=
# BugLogin 2.0 native desktop runtimes; configure at least one exact checksum-pinned runtime.
# Keep the binary outside the repository; checksum must be lowercase/uppercase SHA-256.
BUGLOGIN_DATA_ROOT=
BUGLOGIN_WAYFERN_BINARY=
BUGLOGIN_WAYFERN_VERSION=
BUGLOGIN_WAYFERN_SHA256=
BUGLOGIN_WAYFERN_ARGS=
BUGLOGIN_BUGMINI_BINARY=
BUGLOGIN_BUGMINI_VERSION=
BUGLOGIN_BUGMINI_SHA256=
BUGLOGIN_BUGMINI_ARGS=
